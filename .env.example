# Intelligence provider. Codex remains the free/default local path.
# Allowed values: codex | openai | anthropic
OPPORTUNITY_RADAR_LLM_PROVIDER=codex

# Optional comma-separated failover. Leave empty to prevent surprise paid API usage.
# Example: openai,anthropic
OPPORTUNITY_RADAR_LLM_FALLBACKS=
OPPORTUNITY_RADAR_LLM_TIMEOUT_MS=240000
OPPORTUNITY_RADAR_LLM_MAX_OUTPUT_TOKENS=12000

# Codex CLI uses your existing `codex login` session. No API key is needed.
OPPORTUNITY_RADAR_CODEX_ENABLED=true
OPPORTUNITY_RADAR_CODEX_MODEL=
OPPORTUNITY_RADAR_CODEX_TIMEOUT_MS=240000
OPPORTUNITY_RADAR_CODEX_IDLE_TIMEOUT_MS=90000
CODEX_CLI_PATH=

# OpenAI Responses API. Recommended balanced default for this workload.
OPENAI_API_KEY=
OPPORTUNITY_RADAR_OPENAI_MODEL=gpt-5.6-terra

# Anthropic Messages API.
ANTHROPIC_API_KEY=
OPPORTUNITY_RADAR_ANTHROPIC_MODEL=claude-sonnet-5

# Optional but strongly recommended for broader public web discovery.
EXA_API_KEY=
OPPORTUNITY_RADAR_EXA_ENABLED=true
OPPORTUNITY_RADAR_EXA_RESULTS_PER_QUERY=15

# Independent web search index. Optional; Exa remains a valid fallback for ATS URL discovery.
TAVILY_API_KEY=
OPPORTUNITY_RADAR_TAVILY_ENABLED=true
OPPORTUNITY_RADAR_TAVILY_RESULTS_PER_QUERY=15

# Official public procurement and structured ATS connectors.
OPPORTUNITY_RADAR_BOAMP_ENABLED=true
OPPORTUNITY_RADAR_TED_ENABLED=true
OPPORTUNITY_RADAR_ATS_ENABLED=true
OPPORTUNITY_RADAR_PUBLIC_SOURCE_LOOKBACK_DAYS=45

# Bounded dynamic-page extraction fallback.
FIRECRAWL_API_KEY=
OPPORTUNITY_RADAR_FIRECRAWL_ENABLED=false
OPPORTUNITY_RADAR_FIRECRAWL_TIMEOUT_MS=25000

# Candidate pool size = valid-card target × multiplier bounded to 2,000.
# Rejected, failed, duplicate and previously known candidates never consume the valid-card target.
OPPORTUNITY_RADAR_CANDIDATE_MULTIPLIER=20

# Conservative local crawler controls.
OPPORTUNITY_RADAR_MAX_PAGES_PER_COMPANY=6
OPPORTUNITY_RADAR_FETCH_TIMEOUT_MS=15000
OPPORTUNITY_RADAR_USER_AGENT=OpportunityRadar/0.1 (single-user research; contact: maintainer@example.com)
